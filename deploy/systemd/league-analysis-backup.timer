# Installed for the lga-deploy account by deploy/provision-server.sh; enabled
# by hand once the first run of its service has passed (docs/deployment.md).
[Unit]
Description=League Analysis: daily database backup

[Timer]
OnCalendar=*-*-* 03:10:00 Europe/Prague
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
