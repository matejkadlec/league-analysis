# Installed for the lga-deploy account by deploy/provision-server.sh; enabled
# by hand once the first run of its service has passed (docs/deployment.md).
[Unit]
Description=League Analysis: daily backup check

[Timer]
OnCalendar=*-*-* 09:30:00 Europe/Prague
RandomizedDelaySec=10min
Persistent=true

[Install]
WantedBy=timers.target
