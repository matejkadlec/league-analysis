# Copy this file to $HOME/.local/share/league-analysis/production.env with
# mode 0600, then replace every placeholder locally. Never commit that copy.
POSTGRES_DB=league_analysis
POSTGRES_USER=league_analysis
POSTGRES_PASSWORD=replace-with-a-private-database-password
JWT_SECRET_KEY=replace-with-at-least-32-private-random-characters

LGA_BIND_ADDRESS=0.0.0.0
LGA_FRONTEND_PORT=8097
LGA_BACKEND_PORT=8098
CORS_ORIGINS=http://pi5ram8:8097
NEXT_PUBLIC_API_URL=http://pi5ram8:8098
NEXT_PUBLIC_SITE_URL=http://pi5ram8:8097
NEXT_PUBLIC_ALLOW_INDEXING=false

LOG_LEVEL=INFO
RIOT_API_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
