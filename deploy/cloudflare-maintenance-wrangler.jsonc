// Wrangler configuration for the edge maintenance fallback Worker.
// Deploy with:  npx wrangler deploy --config deploy/cloudflare-maintenance-wrangler.jsonc
// Auth: `npx wrangler login` (OAuth) on the deploying machine.
// The zone routes (dev./api-dev.leagueanalysis.gg/*) are managed in the
// Cloudflare dashboard and are not declared here, so a deploy only replaces
// the script body.
{
  "name": "league-analysis-maintenance",
  "account_id": "3a64f3e76de16792015dd741831394cd",
  "main": "cloudflare-maintenance-worker.js",
  "compatibility_date": "2026-08-13"
}
