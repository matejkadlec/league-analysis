# Names only. The real file is /etc/league-analysis/backup.env on the
# production host (owner lga-deploy, mode 0600) and never enters Git, GitHub,
# logs or a chat. docs/deployment.md has the no-echo commands that write it.
#
# One line per name, NAME=value, no quotes and no spaces around the equals sign.
#
# A bucket (or a prefix in one) used by League Analysis alone, on FORPSI Object
# Storage, with an access key that can reach nothing else.
RESTIC_REPOSITORY=s3:https://<endpoint>/<bucket>/league-analysis
AWS_ACCESS_KEY_ID=<access key of the dedicated credential>
AWS_SECRET_ACCESS_KEY=<its secret key>
AWS_DEFAULT_REGION=<region the endpoint expects>
