{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // shadcn/ui primitives are vendored, not written here: `components/AGENTS.md`
  // forbids hand-editing them, so an export the CLI shipped and this app does
  // not use is not something to delete. Everything else must be reachable --
  // `deadcode` includes `exports`, so a barrel re-export nobody imports fails
  // the gate rather than accumulating.
  // Lint fixtures are linted, never imported: oxlint reads them from disk, so
  // nothing in the graph reaches them and knip is right that they are
  // unreferenced. Deleting one would silently retire a rule's only test.
  "ignore": ["components/ui/**", ".oxlint-plugins/fixtures/**"]
}
