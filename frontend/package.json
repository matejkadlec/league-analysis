{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.8.1",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "version": "12.0.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:standalone": "test -d .next/standalone || { echo '.next/standalone is missing - run npm run build first' >&2; exit 1; } && rm -rf .next/standalone/public .next/standalone/.next/static && cp -r public .next/standalone/public && cp -r .next/static .next/standalone/.next/static && node .next/standalone/server.js",
    "lint": "oxlint --config oxlint.config.mts --type-aware --report-unused-disable-directives-severity=error .",
    "typecheck": "tsc --noEmit",
    "deadcode": "knip --include files,dependencies,devDependencies,unlisted,exports,types,duplicates --no-progress",
    "test": "vitest run",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": "26.8.1"
  },
  "dependencies": {
    "@fontsource-variable/montserrat": "^5.3.0",
    "@marsidev/react-turnstile": "^1.6.1",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tanstack/react-query": "^5.102.8",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.41.0",
    "next": "16.3.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.87.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "30.0.1",
    "knip": "^6.34.0",
    "msw": "^2.15.0",
    "oxlint": "1.81.0",
    "oxlint-tsgolint": "7.0.2001",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "postcss": "8.5.26",
    "sharp": "0.35.4"
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "msw@2.15.0": false,
    "unrs-resolver@1.12.2": true
  }
}
