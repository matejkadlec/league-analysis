# Local development only. Copy to .env and replace both placeholders.
ENVIRONMENT=dev
DEBUG=false
LOG_LEVEL=INFO
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=league_analysis_local_dev
POSTGRES_USER=league_analysis
POSTGRES_PASSWORD=replace_with_your_local_database_password
JWT_SECRET_KEY=replace_with_a_fresh_random_secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Riot API keys belong in the administrator Settings page, never this file.
# Email delivery and Cloudflare Turnstile are optional for local exploration.
