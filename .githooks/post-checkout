#!/usr/bin/env bash
# Trusted snapshot installed outside branch-controlled worktree files. The
# installed copy must never execute the checked-out branch's hook source.
set -u

if [[ "${3:-}" != "1" ]]; then
  exit 0
fi

hook_dir="$(CDPATH='' cd -- "$(dirname -- "$0")" && pwd -P)" || exit 0
provisioner="$hook_dir/provision-worktree-local-files.sh"

if [[ ! -x "$provisioner" ]]; then
  exit 0
fi

"$provisioner" >/dev/null 2>&1 || true
exit 0
